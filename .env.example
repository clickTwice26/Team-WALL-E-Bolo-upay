# Copy to .env and fill in. Never commit .env.

# Public domain pointing at your server (A record). Needed for HTTPS.
DOMAIN=bolo.example.com

# Optional LLM for the second, independent parsing path.
# Leave LLM_PROVIDER empty to run on the rule-based parser only.
# Demo: gemini. Production: a local model (Ollama / llama.cpp) so customer
# text never leaves upay's servers; see README "LLM today, local model in production".
# anthropic | openai | gemini
LLM_PROVIDER=
LLM_API_KEY=
# Optional model override (defaults: anthropic=claude-opus-5-5, openai=gpt-4o-mini, gemini=gemini-2.5-flash)
LLM_MODEL=

# Seconds a RED transfer stays on hold before the user may continue with PIN.
HOLD_SECONDS=30

# Comma-separated allowed origins for the API (the web app is same-origin).
CORS_ORIGINS=*

# ---- sessions and access ----
# Secret that signs session tokens. Set a long random value (openssl rand -hex 32);
# without it sessions end whenever the server restarts.
AUTH_SECRET=
# Minutes a customer session lasts before the PIN screen comes back.
SESSION_MINUTES=30

# true only for the public demo: persona picker, switching demo users, resetting
# the demo data, simulated time of day, and the default console code.
DEMO_MODE=false

# Lets ops tools read /api/dashboard and reset data (header X-Admin-Token).
# Empty = no admin access.
ADMIN_TOKEN=

# Support console at https://$DOMAIN/console. Prefer named accounts:
#   CONSOLE_STAFF=Mitu:<password or bcrypt hash>,Rafi:<...>
# Without CONSOLE_STAFF one shared CONSOLE_TOKEN is used. The default code
# "support-demo" is accepted only when DEMO_MODE=true.
CONSOLE_STAFF=
CONSOLE_TOKEN=

# ---- wallet and scale (docs/SCALE.md) ----
# local = SQLite ledger; mock_upay = simulated upay API (latency + failures)
WALLET_ADAPTER=local
MOCK_UPAY_LATENCY_MS=120
MOCK_UPAY_FAILURE_RATE=0.02
# gunicorn worker processes (default one per CPU), e.g.
# WEB_CONCURRENCY=4

# Copy to .env and fill in. Never commit .env.

# Public domain pointing at your server (A record). Needed for HTTPS.
DOMAIN=bolo.example.com

# Optional LLM for the second, independent parsing path.
# Leave LLM_PROVIDER empty to run on the rule-based parser only.
# anthropic | openai | gemini
LLM_PROVIDER=
LLM_API_KEY=
# Optional model override (defaults: anthropic=claude-opus-5-5, openai=gpt-4o-mini, gemini=gemini-2.5-flash)
LLM_MODEL=

# Seconds a RED transfer stays on hold before the user may continue with PIN.
HOLD_SECONDS=30

# Comma-separated allowed origins for the API (the web app is same-origin).
CORS_ORIGINS=*
